# Default... normalize line endings to LF in repo
* text=auto eol=lf

# --- Unity binary formats ---
*.unity         binary
*.prefab        binary
*.asset         binary
*.meta          binary
*.mat           binary
*.anim          binary
*.controller    binary
*.overrideController binary
*.physicMaterial binary
*.physicsMaterial2D binary
*.playable      binary
*.mask          binary
*.brush         binary
*.flare         binary
*.fontsettings  binary
*.guiskin       binary
*.mixer         binary
*.shadervariants binary
*.spriteatlas   binary
*.renderTexture binary
*.lighting      binary
*.lightingSettings binary
*.giparams      binary
*.signal        binary
*.terrainlayer  binary

# --- Scene / build settings ---
*.unity         merge=unityyamlmerge
*.prefab        merge=unityyamlmerge


<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="ButtonsContainer" style="flex-grow: 0; justify-content: center; align-items: center; align-self: auto; align-content: auto; flex-direction: column; flex-wrap: nowrap; height: 100%; width: auto; background-image: url(&quot;project://database/Assets/Images/Background2.png?fileID=2800000&amp;guid=fa2b17b285c9b3545b5ee03e7dace0fe&amp;type=3#Background2&quot;);">

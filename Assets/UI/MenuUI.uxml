        <engine:Button name="ExitButton" style="background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Images/FreeHorrorUi.png?fileID=-6316473585962384903&amp;guid=105678d5a1df9f742bf0378f0506963d&amp;type=3#FreeHorrorUi_78&quot;); height: 100px; width: 300px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin-top: 16px; margin-right: 16px; margin-bottom: 16px; margin-left: 16px;" />

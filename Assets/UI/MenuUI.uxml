        <engine:VisualElement name="SettingsBackground" style="flex-grow: 1; background-color: rgb(19, 0, 0); position: absolute; -unity-background-image-tint-color: rgb(19, 19, 19); top: 0; right: 0; left: 0; bottom: 0; display: none;">
            <engine:VisualElement name="LabelContainer" style="flex-grow: 1; width: auto;">
                <engine:Button text="Exit" name="ExitButton" style="align-items: flex-start; justify-content: flex-start; align-content: auto; position: relative; top: 2%; left: 2%; flex-direction: column-reverse; flex-shrink: 1; bottom: auto; margin-top: 2px; align-self: flex-start; margin-left: 2px; margin-right: 2px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/DungeonFont.ttf?fileID=12800000&amp;guid=6af6a647d8350194591079b6f4f242cf&amp;type=3#DungeonFont&quot;); font-size: 64px; background-image: url(&quot;project://database/Assets/Images/FreeHorrorUi.png?fileID=-5960030357524467174&amp;guid=105678d5a1df9f742bf0378f0506963d&amp;type=3#FreeHorrorUi_88&quot;); color: rgb(255, 255, 255); background-color: rgba(188, 188, 188, 0); -unity-text-outline-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(253, 253, 253); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
                <engine:Label text="Settings" name="SettingsLabel" double-click-selects-word="true" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/DungeonFont.ttf?fileID=12800000&amp;guid=6af6a647d8350194591079b6f4f242cf&amp;type=3#DungeonFont&quot;); color: rgb(255, 64, 64); font-size: 86px; margin-top: 16px; -unity-text-align: middle-center; align-items: center; justify-content: center; align-self: center;" />
